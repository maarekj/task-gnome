{
  // Declarations for gnim, which ships TypeScript sources that do not type-check against the
  // current @girs typings. Our code is checked against these declarations (see tsconfig.base.json `paths`).
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "gnim/gnome",
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "rootDir": "types/.gnim-src",
    "outDir": "types/gnim"
  },
  "files": ["src/env.d.ts"],
  "include": ["types/.gnim-src/**/*.ts"]
}
